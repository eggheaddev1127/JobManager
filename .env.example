# Copy to .env on the server and fill in. Never commit .env.

# Public domain the app is served on (DNS A record must point at the VPS).
DOMAIN=jobmanager.example.com
# Optional extra hostnames on the same certificate, space-separated (e.g. www.).
EXTRA_DOMAINS=

# Let's Encrypt account email (expiry notices).
LETSENCRYPT_EMAIL=you@example.com
# Set to 1 while testing to avoid Let's Encrypt rate limits (cert won't be trusted).
LETSENCRYPT_STAGING=0

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: comma-separated superadmin emails (defaults are built into the server).
SUPERADMIN_EMAILS=
